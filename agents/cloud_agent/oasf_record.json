{
  "name": "cloud-agent",
  "version": "1.0.0",
  "schema_version": "0.7.0",
  "description": "Universal cloud observability, control-plane execution, and anomaly detection agent supporting any cloud provider via pluggable adapters.",
  "skills": [
    {"name": "cloud.monitoring.metrics"},
    {"name": "cloud.monitoring.health_check"},
    {"name": "cloud.execute.action"},
    {"name": "cloud.discover.resources"},
    {"name": "cloud.diagnose.anomaly"},
    {"name": "cloud.list.resources"}
  ],
  "domains": ["cloud-infrastructure", "observability", "control-plane"],
  "locators": [
    {"type": "openapi", "url": "http://cloud-agent:8005/openapi.json"}
  ],
  "modules": {
    "protocols": ["rest", "mock", "mock_cloud", "aws", "gcp", "coms"],
    "resource_types": ["virtual_machine", "kubernetes_cluster", "namespace", "load_balancer", "virtual_network", "subnet", "database_service", "storage_service", "server", "switch", "router", "firewall", "storage"],
    "provider_resource_map": {
      "mock_cloud": {
        "label": "mock_server(cloud)",
        "api_base": "/api/v1/devices",
        "resource_types": ["virtual_machine", "kubernetes_cluster", "namespace", "load_balancer", "virtual_network", "subnet", "database_service", "storage_service"]
      },
      "coms": {
        "label": "mock_server(ComOps)",
        "api_base": "/compute-ops-mgmt/v1/devices",
        "resource_types": ["server", "switch", "router", "firewall", "storage"]
      }
    }
  }
}
