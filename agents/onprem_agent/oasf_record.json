{
  "name": "onprem-agent",
  "version": "1.0.0",
  "schema_version": "0.7.0",
  "description": "HPE OneView composable infrastructure agent for on-premises server, storage and interconnect management.",
  "authors": ["infra-team@company.com"],
  "skills": [
    {"name": "onprem.monitoring.health"},
    {"name": "onprem.monitoring.utilization"},
    {"name": "onprem.monitoring.alerts"},
    {"name": "onprem.execute.power_action"},
    {"name": "onprem.execute.profile_assign"},
    {"name": "onprem.execute.firmware_update"},
    {"name": "onprem.discover.inventory"},
    {"name": "onprem.diagnose.anomaly"},
    {"name": "onprem.sync.cmdb"},
    {"name": "onprem.list.resources"}
  ],
  "domains": ["onprem-infrastructure", "composable-infrastructure", "observability"],
  "locators": [
    {"type": "openapi", "url": "http://onprem-agent:8008/openapi.json"}
  ],
  "modules": {
    "providers": ["oneview", "mock_onprem", "mock_oneview"],
    "resource_types": ["server", "server_hardware", "server_profile", "enclosure", "interconnect", "logical_switch", "composable_resource", "firmware", "switch"],
    "provider_resource_map": {
      "mock_oneview": {
        "label": "mock_server(OneView)",
        "api_base": "/rest/server-hardware",
        "resource_types": ["server", "server_hardware", "server_profile", "enclosure", "interconnect", "switch"]
      }
    }
  }
}
